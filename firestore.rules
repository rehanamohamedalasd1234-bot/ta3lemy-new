rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // يظل الوصول إلى بقية قاعدة البيانات مغلقًا
    match /{document=**} {
      allow read, write: if false;
    }

    // يسمح للمعلم الموثق بالهاتف بفحص مستند حسابه فقط
    match /teacher_accounts/{uid} {
      allow get: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'phone';
    }

    // يسمح للمعلم الموثق بتقديم أو تحديث طلبه المعلّق فقط
    match /teacher_access_requests/{uid} {
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'phone'
        && request.auth.token.phone_number == request.resource.data.phoneNumber
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.displayName is string
        && request.resource.data.requestedAt is string
        && request.resource.data.keys().hasOnly([
          'uid',
          'phoneNumber',
          'displayName',
          'status',
          'requestedAt'
        ]);
    }

    // ملفات شخصية عامة؛ لا تعتمد قواعد الطالب على مطالبة مؤقتة داخل رمز الدخول.
    function canReadPublicProfiles() {
      return request.auth != null
        && (request.auth.token.firebase.sign_in_provider == 'custom'
          || request.auth.token.firebase.sign_in_provider == 'phone'
          || request.auth.token.role == 'owner'
          || request.auth.token.owner == true);
    }

    function canWriteOwnPublicProfile(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'displayName', 'role', 'avatarURL', 'stage', 'grade', 'visible', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.avatarURL is string
        && request.resource.data.avatarURL.size() <= 2048
        && (request.resource.data.avatarURL == ''
          || request.resource.data.avatarURL.matches('https://res\\.cloudinary\\.com/.*'))
        && request.resource.data.visible is bool
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 50
        && (!request.resource.data.keys().hasAny(['stage'])
          || (request.resource.data.stage is string && request.resource.data.stage.size() <= 80))
        && (!request.resource.data.keys().hasAny(['grade'])
          || (request.resource.data.grade is string && request.resource.data.grade.size() <= 80))
        && ((request.resource.data.role == 'student'
              && request.auth.token.firebase.sign_in_provider == 'custom')
          || (request.resource.data.role == 'teacher'
              && request.auth.token.firebase.sign_in_provider == 'phone'
              && exists(/databases/$(database)/documents/teacher_accounts/$(uid)))
          || (request.resource.data.role == 'owner'
            && (request.auth.token.role == 'owner' || request.auth.token.owner == true)));
    }

    match /public_profiles/{uid} {
      allow get: if canReadPublicProfiles()
        && (request.auth.uid == uid || resource.data.visible == true);
      allow list: if canReadPublicProfiles() && resource.data.visible == true;
      allow create, update: if canWriteOwnPublicProfile(uid);
    }
  }
}
